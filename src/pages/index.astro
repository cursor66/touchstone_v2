---
/**
 * 首页：Hero 轮播 + 内容工具栏（类型筛选 / 排序 / 搜索）+ 内容网格 + 精选系列专题
 * 工具栏为真实可用的客户端交互，数据来自 content/ 内容集合。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCarousel from '../components/home/HeroCarousel.astro';
import ContentCard from '../components/cards/ContentCard.astro';
import SeriesCard from '../components/cards/SeriesCard.astro';
import SectionHeading from '../components/layout/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import Select from '../components/ui/Select.astro';
import { heroSlides } from '../data/hero';
import { series } from '../data/series';
import { getAllContent } from '../utils/content';

const items = await getAllContent();

// 系列文章数按 frontmatter 中的 series 标签实时统计
const seriesCounts: Record<string, number> = {};
for (const { entry } of items) {
  const s = entry.data.series;
  if (s) seriesCounts[s] = (seriesCounts[s] ?? 0) + 1;
}
---

<BaseLayout>
  <HeroCarousel slides={heroSlides} />

  <main class="max-w-7xl mx-auto px-4 py-12">
    <div class="max-w-5xl mx-auto">
      <!-- 内容工具栏 -->
      <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-6">
        <div class="flex items-center space-x-4">
          <Select id="content-filter" options={['全部内容', '文章专栏', '影像视频', '学习资源']} />
          <div class="h-4 w-px bg-gray-200 hidden md:block"></div>
          <div class="flex space-x-2">
            <Button variant="primary" data-sort-btn="new">最新发布</Button>
            <Button variant="secondary" data-sort-btn="hot">最热排行</Button>
          </div>
        </div>
      </div>

      <!-- 内容网格（文章 / 视频 / 资源混排，支持筛选与排序） -->
      <div id="content-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {items.map(({ entry, href, type }) => (
          <div
            data-card
            data-type={type}
            data-date={entry.data.date.getTime()}
            data-likes={entry.data.likes}
            data-title={entry.data.title.toLowerCase()}
          >
            <ContentCard
            title={entry.data.title}
            href={href}
            cover={entry.data.cover}
            type={type}
            date={entry.data.date}
            views={entry.data.views}
            comments={entry.data.comments}
          />
          </div>
        ))}
      </div>

      <div id="content-empty" class="hidden bg-white rounded-2xl p-8 border border-gray-200 text-center">
        <p class="text-sm text-gray-500">没有匹配的内容，换个关键词或分类试试。</p>
      </div>

      <!-- 翻页组件：内容 ≤9 个时自动隐藏 -->
      <nav id="content-pager" class="mt-8 hidden items-center justify-center gap-2 text-sm" aria-label="内容分页"></nav>

      <!-- 精选系列专题 -->
      <div class="mt-16">
        <SectionHeading title="精选系列专题" />
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {series.map((s) => (
            <SeriesCard
              title={s.title}
              description={s.description}
              count={seriesCounts[s.id] ?? 0}
              icon={s.icon}
              color={s.color}
              href={s.href}
            />
          ))}
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<script is:inline>
  (function () {
    const grid = document.getElementById('content-grid');
    if (!grid) return;

    const cards = Array.from(grid.querySelectorAll('[data-card]'));
    const empty = document.getElementById('content-empty');
    const filter = document.getElementById('content-filter');
    const sortBtns = document.querySelectorAll('[data-sort-btn]');
    const typeMap = ['all', 'article', 'video', 'resource'];

    let sortBy = 'new';
    let query = '';
    let page = 1;
    const PAGE_SIZE = 9;
    const pager = document.getElementById('content-pager');

    // Header 搜索框：输入即筛选（首页），回车跳转到首页带关键词
    const search = document.querySelector('[data-search-input]');
    const params = new URLSearchParams(location.search);
    if (params.get('q')) {
      query = params.get('q').toLowerCase();
      if (search) search.value = params.get('q');
    }

    function pagerBtn(label, opts) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = label;
      btn.className =
        'min-w-8 h-8 px-2 rounded-lg border transition ' +
        (opts.active
          ? 'bg-blue-600 text-white border-blue-600'
          : 'bg-white text-gray-600 border-gray-200 hover:bg-gray-50') +
        (opts.disabled ? ' opacity-40 cursor-not-allowed' : '');
      if (opts.disabled) btn.disabled = true;
      if (opts.page) {
        btn.addEventListener('click', () => {
          page = opts.page;
          apply();
          grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }
      return btn;
    }

    // 页码序列：页数多时折叠为 1 … c-1 c c+1 … last
    function pageNumbers(total, current) {
      if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
      const set = new Set([1, total, current - 1, current, current + 1]);
      const list = Array.from(set).filter((n) => n >= 1 && n <= total).sort((a, b) => a - b);
      const out = [];
      let prev = 0;
      for (const n of list) {
        if (prev && n - prev > 1) out.push('…');
        out.push(n);
        prev = n;
      }
      return out;
    }

    function renderPager(totalPages) {
      pager.innerHTML = '';
      if (totalPages <= 1) {
        pager.classList.add('hidden');
        pager.classList.remove('flex');
        return;
      }
      pager.classList.remove('hidden');
      pager.classList.add('flex');

      pager.appendChild(pagerBtn('‹ 上一页', { disabled: page === 1, page: page - 1 }));
      pageNumbers(totalPages, page).forEach((n) => {
        if (n === '…') {
          const span = document.createElement('span');
          span.textContent = '…';
          span.className = 'px-1 text-gray-400';
          pager.appendChild(span);
        } else {
          pager.appendChild(pagerBtn(String(n), { active: n === page, page: n }));
        }
      });
      pager.appendChild(pagerBtn('下一页 ›', { disabled: page === totalPages, page: page + 1 }));
    }

    function apply() {
      const type = typeMap[Number(filter.value)] || 'all';

      const visible = [];
      cards.forEach((el) => {
        const okType = type === 'all' || el.dataset.type === type;
        const okQuery = !query || el.dataset.title.includes(query);
        const show = okType && okQuery;
        el.classList.toggle('hidden', !show);
        if (show) visible.push(el);
      });

      visible.sort((a, b) =>
        sortBy === 'hot'
          ? Number(b.dataset.likes) - Number(a.dataset.likes)
          : Number(b.dataset.date) - Number(a.dataset.date),
      );
      visible.forEach((el) => grid.appendChild(el));

      // 分页：只显示当前页的 9 个
      const totalPages = Math.ceil(visible.length / PAGE_SIZE);
      if (page > totalPages) page = Math.max(1, totalPages);
      visible.forEach((el, i) => {
        const inPage = i >= (page - 1) * PAGE_SIZE && i < page * PAGE_SIZE;
        el.classList.toggle('hidden', !inPage);
      });
      renderPager(totalPages);

      empty.classList.toggle('hidden', visible.length > 0);
      grid.classList.toggle('hidden', visible.length === 0);
    }

    filter.addEventListener('change', () => {
      page = 1;
      apply();
    });

    sortBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        sortBy = btn.dataset.sortBtn;
        // 切换 primary / secondary 样式
        sortBtns.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('bg-blue-600', active);
          b.classList.toggle('text-white', active);
          b.classList.toggle('bg-white', !active);
          b.classList.toggle('text-gray-600', !active);
          b.classList.toggle('border', !active);
          b.classList.toggle('border-gray-200', !active);
          b.classList.toggle('hover:bg-gray-50', !active);
        });
        page = 1;
        apply();
      });
    });

    if (search) {
      search.addEventListener('input', () => {
        query = search.value.trim().toLowerCase();
        page = 1;
        apply();
      });
    }

    apply();
  })();
</script>
