---
/**
 * 区块标题（设计稿「精选系列专题」样式还原）：
 * 左侧蓝色竖条 + 标题，右侧可选「查看全部」链接。
 */
import Icon from '../ui/Icon.astro';

interface Props {
  title: string;
  linkText?: string;
  linkHref?: string;
}

const { title, linkText, linkHref = '#' } = Astro.props;
---

<div class="flex items-center justify-between mb-8">
  <div class="flex items-center space-x-3">
    <div class="w-2 h-8 bg-blue-600 rounded-full"></div>
    <h2 class="text-2xl font-bold">{title}</h2>
  </div>
  {linkText && (
    <a href={linkHref} class="text-sm text-blue-600 font-medium hover:underline">
      {linkText} <Icon name="chevron-right" class="inline w-3 h-3 ml-1" />
    </a>
  )}
</div>
