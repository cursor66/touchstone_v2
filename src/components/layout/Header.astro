---
/**
 * 页头（设计稿还原）：sticky 白色导航 + Logo + 搜索框
 * 搜索框：首页实时筛选内容网格；其他页面回车跳转到首页并按关键词过滤。
 */
import Icon from '../ui/Icon.astro';
import SearchInput from '../ui/SearchInput.astro';
import { site } from '../../data/site';
---

<header id="header" class="bg-white sticky top-0 z-50 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
    <div class="flex items-center">
      <a href="/" class="flex items-center space-x-2">
        <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center text-white">
          <Icon name="mountain" class="w-4 h-4" />
        </div>
        <div>
          <h1 class="text-xl font-bold tracking-tight">{site.name}</h1>
          <p class="text-[10px] text-gray-500 leading-none">{site.tagline}</p>
        </div>
      </a>
    </div>
    <div class="flex items-center space-x-4">
      <SearchInput class="w-64 hidden md:block" />
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const search = document.querySelector('[data-search-input]');
    if (!search) return;
    search.addEventListener('keydown', (e) => {
      // 非首页时回车跳转到首页搜索（首页由页面脚本直接实时筛选）
      if (e.key === 'Enter' && !document.getElementById('content-grid')) {
        const q = search.value.trim();
        location.href = q ? '/?q=' + encodeURIComponent(q) : '/';
      }
    });
  })();
</script>
