---
/**
 * 搜索输入框（设计稿还原）：圆角全圆、左侧放大镜图标、聚焦蓝色 ring。
 */
import Icon from './Icon.astro';

interface Props {
  placeholder?: string;
  class?: string;
}

const { placeholder = '搜索文章、视频、资源...', class: className = 'w-64' } = Astro.props;
---

<div class={`relative group ${className}`}>
  <input
    type="text"
    placeholder={placeholder}
    data-search-input
    class="bg-gray-100 border-none rounded-full py-2 px-4 pl-10 text-sm w-full focus:ring-2 focus:ring-blue-500 transition-all outline-none"
  />
  <Icon name="search" class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 w-4 h-4" />
</div>
