---
/**
 * 下拉选择框（设计稿还原）：白底描边、右侧 chevron、hover 蓝边。
 */
import Icon from './Icon.astro';

interface Props {
  options: string[];
  class?: string;
}

const { options, class: className = '' } = Astro.props;
---

<div class={`relative inline-block ${className}`}>
  <select
    class="appearance-none bg-white border border-gray-200 text-gray-700 py-2 pl-4 pr-10 rounded-md text-sm font-medium focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all cursor-pointer hover:border-blue-400"
  >
    {options.map((opt, i) => <option selected={i === 0}>{opt}</option>)}
  </select>
  <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-gray-400">
    <Icon name="chevron-down" class="w-2.5 h-2.5" />
  </div>
</div>
