---
/**
 * 系列专题卡片（设计稿渐变卡片还原）
 * color 控制整套配色（渐变底 / 描边 / 图标底 / 链接色），
 * 新增配色时只需在 palette 中追加一条完整的 class 记录。
 */
import Icon from '../ui/Icon.astro';

interface Props {
  title: string;
  description: string;
  count: number;
  icon: 'robot' | 'seedling' | 'camera-retro';
  color?: 'blue' | 'emerald' | 'orange';
  href?: string;
}

const palette = {
  blue: {
    card: 'bg-gradient-to-br from-blue-50 to-indigo-50 border-blue-100',
    icon: 'bg-blue-600',
    link: 'text-blue-600',
  },
  emerald: {
    card: 'bg-gradient-to-br from-emerald-50 to-teal-50 border-emerald-100',
    icon: 'bg-emerald-600',
    link: 'text-emerald-600',
  },
  orange: {
    card: 'bg-gradient-to-br from-orange-50 to-amber-50 border-orange-100',
    icon: 'bg-orange-600',
    link: 'text-orange-600',
  },
} as const;

const { title, description, count, icon, color = 'blue', href = '#' } = Astro.props;
const p = palette[color];
---

<a
  href={href}
  class={`bg-gradient-to-br rounded-2xl p-8 border hover:shadow-lg transition-all group cursor-pointer text-left flex flex-col h-full ${p.card}`}
>
  <div class={`w-14 h-14 ${p.icon} rounded-xl flex items-center justify-center text-white text-2xl mb-6 group-hover:scale-110 transition-transform`}>
    <Icon name={icon} class="w-7 h-7" />
  </div>
  <h4 class="text-xl font-bold mb-3">{title}</h4>
  <p class="text-sm text-gray-500 mb-6 leading-relaxed">{description}</p>
  <div class={`flex items-center ${p.link} text-sm font-bold mt-auto`}>
    {count} 篇文章 <span class="mx-2">·</span> 立即开启
    <Icon name="chevron-right" class="w-3 h-3 ml-1 group-hover:translate-x-1 transition-transform" />
  </div>
</a>
